{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["@kontent-ai/biome-config/base"],
	"formatter": {
		"indentWidth": 4,
		"indentStyle": "tab",
		"lineWidth": 140
	},
	"linter": {
		"rules": {
			"correctness": {
				"noUnusedImports": {
					"fix": "safe",
					"level": "error"
				},
				"useImportExtensions": {
					"level": "error",
					"options": {
						"forceJsExtensions": true
					}
				}
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["lib/**", "!lib/schema/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@zod/mini": "Zod may only be used in lib/schema, type caller schemas with StandardSchemaV1 instead.",
									"zod": "Zod may only be used in lib/schema, type caller schemas with StandardSchemaV1 instead.",
									"zod/mini": "Zod may only be used in lib/schema, type caller schemas with StandardSchemaV1 instead."
								}
							}
						}
					}
				}
			}
		}
	],
	"files": {
		"includes": ["lib/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "**/*.json", "!dist/**/*"]
	}
}
