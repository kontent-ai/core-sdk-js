{
	"name": "@kontent-ai/core-sdk",
	"version": "12.0.0-preview.46",
	"repository": {
		"type": "git",
		"url": "https://github.com/kontent-ai/core-sdk-js"
	},
	"private": false,
	"author": "richard sustek",
	"license": "MIT",
	"description": "Core package with shared / common functionality for Kontent.ai SDKs",
	"keywords": [
		"Kontent.ai",
		"Kontent AI",
		"Kontent SDK Core"
	],
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/public_api.d.ts",
			"default": "./dist/public_api.js"
		},
		"./devkit": {
			"types": "./dist/devkit_api.d.ts",
			"default": "./dist/devkit_api.js"
		},
		"./testkit": {
			"types": "./dist/testkit_api.d.ts",
			"default": "./dist/testkit_api.js"
		}
	},
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"sideEffects": false,
	"scripts": {
		"prepublishOnly": "pnpm run build && pnpm run test",
		"build": "pnpm run lint && pnpm run clean && pnpm run build:ts && pnpm run update:version",
		"build:ts": "tsc -p tsconfig.build.json",
		"test": "vitest run --config=vitest.config.ts --coverage",
		"test:unit": "vitest run --config=vitest-unit.config.ts",
		"test:integration": "vitest run --config=vitest-integration.config.ts",
		"lint": "pnpm run knip && pnpm run biome:check && pnpm run oxlint && pnpm run knip",
		"oxlint": "oxlint --type-aware --type-check --deny-warnings lib tests scripts",
		"knip": "knip",
		"knip:production": "knip --production",
		"biome:check": "biome check",
		"biome:fix": "biome check --write",
		"biome:fix:unsafe": "biome check --write --unsafe",
		"clean": "tsx ./scripts/clean.ts",
		"update:version": "tsx ./scripts/update-version.ts",
		"bump:patch": "pnpm run build && npm version patch -m \"v%s\" && pnpm run build:ts && git push --follow-tags",
		"bump:minor": "pnpm run build && npm version minor -m \"v%s\" && pnpm run build:ts && git push --follow-tags",
		"bump:major": "pnpm run build && npm version major -m \"v%s\" && pnpm run build:ts && git push --follow-tags"
	},
	"peerDependencies": {
		"ts-pattern": "^5",
		"vitest": "^5",
		"@zod/mini": "^4"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@kontent-ai/biome-config": "0.7.3",
		"@kontent-ai/oxlint-config": "0.0.4",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"@zod/mini": "4.6.7",
		"knip": "6.42.1",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
